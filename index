<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta http-equiv="Cache-Control" content="no-store">
<title>Voos IGU - Rede OOH</title>
<style>
:root{
  --bg1:#071827;
  --bg2:#0d3450;
  --panel:#ffffff;
  --text:#102033;
  --muted:#607080;
  --head:#123c5b;
}
*{box-sizing:border-box}
html,body{
  margin:0;width:100%;height:100%;overflow:hidden;background:#000;
  font-family:Arial,Helvetica,sans-serif;
}
#stage{
  position:absolute;
  left:50%;top:50%;
  width:2160px;height:3840px;
  transform-origin:center center;
}
.screen{
  width:2160px;height:3840px;
  padding:150px 120px 110px;
  display:flex;
  flex-direction:column;
  background:
    radial-gradient(circle at 80% 5%,rgba(255,255,255,.16),transparent 20%),
    linear-gradient(180deg,var(--bg1),var(--bg2));
  color:#fff;
}
.header{text-align:center}
.kicker{
  font-size:48px;
  letter-spacing:10px;
  font-weight:800;
  opacity:.75;
}
.title{
  margin-top:34px;
  font-size:110px;
  line-height:1.05;
  font-weight:900;
}
.subtitle{
  margin-top:26px;
  font-size:48px;
  opacity:.74;
}
.boards{
  flex:1;
  margin-top:100px;
  display:grid;
  grid-template-rows:1fr 1fr;
  gap:70px;
  min-height:0;
}
.panel{
  background:var(--panel);
  border-radius:48px;
  overflow:hidden;
  box-shadow:0 28px 70px rgba(0,0,0,.2);
  display:flex;
  flex-direction:column;
}
.panel-head{
  background:var(--head);
  color:#fff;
  padding:36px 46px;
  font-size:62px;
  font-weight:900;
  letter-spacing:2px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.badge{
  font-size:38px;
  font-weight:800;
  opacity:.78;
}
.framewrap{
  flex:1;
  min-height:0;
  overflow:hidden;
  background:#fff;
}
iframe{
  width:100%;
  height:100%;
  border:0;
  background:#fff;
}
.footer{
  margin-top:54px;
  text-align:center;
  font-size:36px;
  line-height:1.35;
  opacity:.72;
}
</style>
</head>
<body>
<div id="stage">
<div class="screen">
  <header class="header">
    <div class="kicker">REDE OOH • INFORMAÇÃO AO VIAJANTE</div>
    <div class="title">AEROPORTO DE FOZ DO IGUAÇU</div>
    <div class="subtitle">IGU • Chegadas e partidas</div>
  </header>

  <section class="boards">
    <div class="panel">
      <div class="panel-head">
        <span>✈ PARTIDAS</span>
        <span class="badge">IGU</span>
      </div>
      <div class="framewrap">
        <iframe src="https://www.avionio.com/widget/pt/igu/departures?style=3" loading="eager"></iframe>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">
        <span>🛬 CHEGADAS</span>
        <span class="badge">IGU</span>
      </div>
      <div class="framewrap">
        <iframe src="https://www.avionio.com/widget/pt/igu/arrivals?style=3" loading="eager"></iframe>
      </div>
    </div>
  </section>

  <footer class="footer">
    Informações sujeitas a alterações operacionais. Consulte a companhia aérea para confirmação.
  </footer>
</div>
</div>

<script>
function fit(){
  const s=Math.min(innerWidth/2160,innerHeight/3840);
  document.getElementById('stage').style.transform=`translate(-50%,-50%) scale(${s})`;
}
addEventListener('resize',fit);
fit();
</script>
</body>
</html>
